# Build from the repo root:
#   docker build -f dockerfiles/Dockerfile.ws-server -t hawsl-ws-server .

FROM oven/bun:1.3.14-slim
WORKDIR /app

# bun validates the lockfile against every workspace, so all manifests are needed
COPY package.json bun.lock ./
COPY apps/client-frtd/package.json apps/client-frtd/
COPY apps/exchange-server/package.json apps/exchange-server/
COPY apps/ws-server/package.json apps/ws-server/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/typescript-config/package.json packages/typescript-config/
COPY packages/ui/package.json packages/ui/
# "./" includes the root package.json, which is where kafkajs is declared for this app
RUN bun install --frozen-lockfile --production --filter ws-server --filter ./

COPY apps/ws-server/tsconfig.json apps/ws-server/
COPY apps/ws-server/src apps/ws-server/src

WORKDIR /app/apps/ws-server
USER bun
EXPOSE 3001
CMD ["bun", "src/index.ts"]