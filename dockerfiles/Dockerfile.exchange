
FROM oven/bun:1.3.14-slim
WORKDIR /app

COPY package.json bun.lock ./
COPY apps/client-frtd/package.json apps/client-frtd/
COPY apps/exchange-server/package.json apps/exchange-server/
COPY apps/ws-server/package.json apps/ws-server/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/typescript-config/package.json packages/typescript-config/
COPY packages/ui/package.json packages/ui/
RUN bun install --frozen-lockfile --production --filter exchange-server

COPY apps/exchange-server/tsconfig.json apps/exchange-server/
COPY apps/exchange-server/src apps/exchange-server/src

WORKDIR /app/apps/exchange-server
USER bun
CMD ["bun", "src/index.ts"]
