# Build from the repo root:
#   docker build -f dockerfiles/Dockerfile.client -t hawsl-client .

FROM oven/bun:1.3.14-slim AS manifests
WORKDIR /app
# bun validates the lockfile against every workspace, so all manifests are needed
COPY package.json bun.lock ./
COPY apps/client-frtd/package.json apps/client-frtd/
COPY apps/exchange-server/package.json apps/exchange-server/
COPY apps/ws-server/package.json apps/ws-server/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/typescript-config/package.json packages/typescript-config/
COPY packages/ui/package.json packages/ui/

FROM manifests AS deps
RUN bun install --frozen-lockfile

FROM manifests AS prod-deps
RUN bun install --frozen-lockfile --production --filter web

# next build and next start run on Node, matching the engines field in package.json
FROM node:24-slim AS build
WORKDIR /app
COPY --from=deps /app ./
COPY apps/client-frtd apps/client-frtd
COPY packages packages
WORKDIR /app/apps/client-frtd
RUN node_modules/.bin/next build

FROM node:24-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=prod-deps /app ./
WORKDIR /app/apps/client-frtd
COPY --from=build --chown=node:node /app/apps/client-frtd/.next .next
COPY apps/client-frtd/next.config.js ./
COPY apps/client-frtd/public public
USER node
EXPOSE 3000
CMD ["node_modules/.bin/next", "start"]
